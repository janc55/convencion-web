---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Agenda from "../components/sections/Agenda.astro";
import Hotels from "../components/sections/Hotels.astro";
import Restaurants from "../components/sections/Restaurants.astro";
import TourismCarousel from "../components/sections/TourismCarousel.astro";
import PostulacionesPreview from "../components/sections/PostulacionesPreview.astro";
import DelegationsNight from "../components/sections/DelegationsNight.astro";
import Semblanza from "../components/sections/Semblanza.astro";
import RegistrationForm from "../components/sections/RegistrationForm.astro";

export const prerender = false;
---

<Layout title="LXXV Convención Nacional - Club de Leones de Bolivia">
	<Navbar />
	<main>
		<Hero />
		<About />
		<Agenda />
		<Hotels />
		<Restaurants />
		<TourismCarousel />
		<PostulacionesPreview />
		<DelegationsNight />
		<Semblanza />
		<RegistrationForm />
	</main>
	<Footer />
</Layout>
