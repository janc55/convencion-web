---
import Layout from "../layouts/Layout.astro";
import PostulacionCard from "../components/ui/PostulacionCard.astro";

export const prerender = false;

const PUBLIC_R2_URL = "https://pub-7dd27b2d2fb34a2289eac5056721ab3e.r2.dev";
interface Postulacion {
    id: string;
    nombre: string;
    cargo: string;
    club: string;
    pdfUrl: string;
    fecha: string;
}

let postulaciones: Postulacion[] = [];

try {
    const response = await fetch(`${PUBLIC_R2_URL}/postulaciones.json`, {
        cache: "no-store",
    });
    if (response.ok) {
        postulaciones = await response.json();
        // Sort by most recent
        postulaciones.sort(
            (a: Postulacion, b: Postulacion) => Number(b.id) - Number(a.id),
        );
    }
} catch (error) {
    console.error("Error fetching postulaciones:", error);
}
---

<Layout title="Postulaciones | LXXV Convención Nacional">
    <main class="min-h-screen bg-surface relative overflow-hidden">
        <!-- Decorative background -->
        <div class="absolute inset-0 hex-pattern opacity-5"></div>
        <div
            class="absolute top-0 left-0 w-full h-64 bg-gradient-to-b from-primary/10 to-transparent"
        >
        </div>

        <div class="max-w-7xl mx-auto px-6 py-20 relative z-10">
            <!-- Header -->
            <div
                class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 animate-on-scroll fade-in"
            >
                <div class="space-y-4">
                    <div class="flex flex-wrap gap-4">
                        <a
                            href="/"
                            class="inline-flex items-center gap-2 text-primary hover:text-tertiary transition-colors group"
                        >
                            <svg
                                class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                            </svg>
                            Inicio
                        </a>
                        <span class="text-outline-variant">/</span>
                        <span class="text-secondary">Postulaciones</span>
                    </div>
                    <h1 class="font-headline text-4xl md:text-6xl text-primary">
                        Postulaciones
                    </h1>
                    <p class="text-secondary text-lg max-w-2xl">
                        Conozca las candidaturas y propuestas de los miembros
                        para la LXXV Convención Nacional.
                    </p>
                </div>

                <div class="flex items-center gap-4">
                    <div
                        class="bg-surface-container-high p-4 rounded-xl border border-primary/20 shadow-lg hidden sm:block"
                    >
                        <div class="text-center">
                            <span class="block text-3xl font-bold text-primary"
                                >{postulaciones.length}</span
                            >
                            <span
                                class="text-[10px] uppercase tracking-widest opacity-70"
                                >Postulaciones</span
                            >
                        </div>
                    </div>
                    <a
                        href="/postulaciones/subir"
                        class="bg-primary text-on-primary px-6 py-3 rounded-lg font-bold hover:bg-tertiary transition-all shadow-lg flex items-center gap-2"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 4v16m8-8H4"></path>
                        </svg>
                        Postularme
                    </a>
                </div>
            </div>

            <!-- Grid -->
            {
                postulaciones.length > 0 ? (
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {postulaciones.map((p: Postulacion) => (
                            <PostulacionCard
                                nombre={p.nombre}
                                cargo={p.cargo}
                                club={p.club}
                                pdfUrl={p.pdfUrl}
                            />
                        ))}
                    </div>
                ) : (
                    <div class="text-center py-24 bg-surface-container-low rounded-2xl border border-dashed border-outline-variant">
                        <svg
                            class="w-16 h-16 mx-auto text-secondary/30 mb-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                            />
                        </svg>
                        <h2 class="text-2xl font-headline text-secondary mb-2">
                            No hay postulaciones registradas
                        </h2>
                        <p class="text-secondary/70 mb-8">
                            Sea el primero en registrar su postulación oficial.
                        </p>
                        <a
                            href="/postulaciones/subir"
                            class="inline-flex items-center gap-2 px-8 py-3 bg-primary text-on-primary rounded-lg font-bold hover:bg-tertiary transition-all shadow-lg"
                        >
                            Subir mi postulación
                        </a>
                    </div>
                )
            }
        </div>

        <!-- Modal Viewer -->
        <div
            id="pdf-modal"
            class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4 md:p-8"
            role="dialog"
            aria-modal="true"
        >
            <div
                class="bg-surface rounded-2xl w-full max-w-5xl h-[90vh] flex flex-col overflow-hidden relative animate-scale-in"
            >
                <!-- Modal Header -->
                <div
                    class="p-4 border-b border-outline-variant flex items-center justify-between bg-surface-container-high"
                >
                    <div class="flex items-center gap-3">
                        <div
                            class="w-10 h-10 bg-primary/10 rounded-lg flex items-center justify-center text-primary"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h3
                                id="modal-title"
                                class="font-headline text-lg text-primary leading-tight"
                            >
                                Documento
                            </h3>
                            <p
                                class="text-[10px] uppercase tracking-widest text-secondary font-bold"
                            >
                                Vista Previa PDF
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <a
                            id="modal-download"
                            href="#"
                            download
                            class="flex items-center gap-2 px-4 py-2 bg-secondary text-white rounded-lg text-sm font-bold hover:bg-secondary/80 transition-colors"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                                ></path>
                            </svg>
                            Descargar
                        </a>
                        <button
                            id="close-pdf-modal"
                            class="w-10 h-10 flex items-center justify-center text-secondary hover:bg-red-500/10 hover:text-red-500 rounded-lg transition-all"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Modal Content -->
                <div class="flex-1 bg-surface-container-low relative">
                    <iframe
                        id="pdf-iframe"
                        class="w-full h-full border-none"
                        title="PDF Viewer"></iframe>
                </div>
            </div>
        </div>
    </main>
</Layout>

<script>
    const pdfModal = document.getElementById("pdf-modal");
    const pdfIframe = document.getElementById(
        "pdf-iframe",
    ) as HTMLIFrameElement;
    const modalTitle = document.getElementById("modal-title");
    const modalDownload = document.getElementById(
        "modal-download",
    ) as HTMLAnchorElement;
    const closeBtn = document.getElementById("close-pdf-modal");

    const openModal = (url: string, name: string) => {
        if (!pdfModal || !pdfIframe || !modalTitle || !modalDownload) return;

        modalTitle.textContent = name;
        modalDownload.href = url;
        modalDownload.download = `${name.replaceAll(" ", "_")}.pdf`;

        pdfIframe.src = `${url}#toolbar=0`;

        pdfModal.classList.remove("hidden");
        pdfModal.classList.add("flex");
        document.body.style.overflow = "hidden";
    };

    const closeModal = () => {
        if (!pdfModal || !pdfIframe) return;
        pdfModal.classList.add("hidden");
        pdfModal.classList.remove("flex");
        pdfIframe.src = "about:blank";
        document.body.style.overflow = "";
    };

    // Add event listeners to all view buttons
    document.querySelectorAll(".view-pdf-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            const url = btn.getAttribute("data-pdf");
            const name = btn.getAttribute("data-name");
            if (url && name) openModal(url, name);
        });
    });

    // Close actions
    if (closeBtn) closeBtn.addEventListener("click", closeModal);
    if (pdfModal) {
        pdfModal.addEventListener("click", (e) => {
            if (e.target === pdfModal) closeModal();
        });
    }

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeModal();
    });
</script>

<style>
    .hex-pattern {
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 0l25.98 15v30L30 60 4.02 45V15z' fill-rule='evenodd' stroke='%23d1d5db' stroke-width='1' fill='none'/%3E%3C/svg%3E");
        background-repeat: repeat;
    }

    @keyframes scale-in {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .animate-scale-in {
        animation: scale-in 0.3s ease-out forwards;
    }
</style>
