---
const PUBLIC_R2_URL = "https://pub-7dd27b2d2fb34a2289eac5056721ab3e.r2.dev";
let count = 0;

try {
    const response = await fetch(`${PUBLIC_R2_URL}/postulaciones.json`);
    if (response.ok) {
        const data = await response.json();
        count = Array.isArray(data) ? data.length : 0;
    }
} catch (error) {
    console.error("Error fetching postulaciones count:", error);
}
---

<section
    class="py-20 bg-surface-container-low relative border-y border-primary/10"
>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div
            class="flex flex-col md:flex-row items-center justify-between gap-12 bg-surface p-8 md:p-12 rounded-2xl shadow-xl border border-primary/20 animate-on-scroll fade-in"
        >
            <div class="flex-1 space-y-4 text-center md:text-left">
                <h2 class="font-headline text-4xl text-primary">
                    Postulaciones de Candidatos
                </h2>
                <p class="text-secondary text-lg max-w-xl mx-auto md:mx-0">
                    Ya contamos con <strong>{count}</strong> postulaciones registradas
                    para la LXXV Convención Nacional. ¡Conozca a sus líderes y sus
                    propuestas!
                </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
                <a
                    href="/postulaciones"
                    class="inline-block bg-primary text-on-primary px-8 py-4 rounded-md font-bold text-center hover:bg-tertiary transition-all hover:scale-105 active:scale-95 shadow-lg"
                >
                    Ver todas las postulaciones
                </a>
                <a
                    href="/postulaciones/subir"
                    class="inline-block bg-secondary/10 text-secondary border border-secondary/30 px-8 py-4 rounded-md font-bold text-center hover:bg-secondary hover:text-white transition-all hover:scale-105 active:scale-95"
                >
                    Subir mi postulación
                </a>
            </div>
        </div>
    </div>
</section>
