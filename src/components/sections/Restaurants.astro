---

---

<section class="py-24 bg-surface-container-low">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="font-headline text-4xl text-on-surface mb-4">
        Gastronomía Orureña
      </h2>
      <div class="flex flex-wrap justify-center gap-2">
        <button
          class="px-4 py-1 text-xs font-bold uppercase tracking-widest bg-primary text-on-primary rounded-full"
          >Típico Boliviano</button
        >
        <button
          class="px-4 py-1 text-xs font-bold uppercase tracking-widest bg-surface-container-high text-secondary rounded-full hover:bg-surface-container-highest transition-colors"
          >Internacional</button
        >
        <button
          class="px-4 py-1 text-xs font-bold uppercase tracking-widest bg-surface-container-high text-secondary rounded-full hover:bg-surface-container-highest transition-colors"
          >Café &amp; Postres</button
        >
      </div>
    </div>
    <div class="grid md:grid-cols-4 gap-6">
      <div
        class="bg-surface p-6 rounded-lg animate-on-scroll from-bottom stagger-1"
      >
        <div class="flex justify-between items-start mb-4">
          <h4 class="font-bold">El Rostro Asado</h4>
          <span class="text-primary flex"
            ><span
              class="material-symbols-outlined text-xs"
              style="font-variation-settings: 'FILL' 1;">star</span
            ></span
          >
        </div>
        <p class="text-xs text-secondary mb-2">Comida Típica</p>
        <p class="text-sm text-on-surface-variant mb-4">
          Calle 6 de octubre esq. Herrera
        </p>
        <p class="text-xs italic opacity-60">Abierto 18:00 - 02:00</p>
      </div>
      <div
        class="bg-surface p-6 rounded-lg animate-on-scroll from-bottom stagger-2"
      >
        <div class="flex justify-between items-start mb-4">
          <h4 class="font-bold">Confitería Center</h4>
          <span class="text-primary flex"
            ><span
              class="material-symbols-outlined text-xs"
              style="font-variation-settings: 'FILL' 1;">star</span
            ></span
          >
        </div>
        <p class="text-xs text-secondary mb-2">Cafetería</p>
        <p class="text-sm text-on-surface-variant mb-4">
          Junín entre Soria Galvarro y La Plata
        </p>
        <p class="text-xs italic opacity-60">Abierto 09:00 - 22:00</p>
      </div>
      <div
        class="bg-surface p-6 rounded-lg animate-on-scroll from-bottom stagger-3"
      >
        <div class="flex justify-between items-start mb-4">
          <h4 class="font-bold">1221 Steakhouse</h4>
          <span class="text-primary flex"
            ><span
              class="material-symbols-outlined text-xs"
              style="font-variation-settings: 'FILL' 1;">star</span
            ></span
          >
        </div>
        <p class="text-xs text-secondary mb-2">Carnes &amp; Grill</p>
        <p class="text-sm text-on-surface-variant mb-4">
          Calle Bolivar #1221 entre Baptista y Linares
        </p>
        <p class="text-xs italic opacity-60">Abierto 17:00 - 23:00</p>
      </div>
      <div
        class="bg-surface p-6 rounded-lg animate-on-scroll from-bottom stagger-4"
      >
        <div class="flex justify-between items-start mb-4">
          <h4 class="font-bold">La Polar</h4>
          <span class="text-primary flex"
            ><span
              class="material-symbols-outlined text-xs"
              style="font-variation-settings: 'FILL' 1;">star</span
            ></span
          >
        </div>
        <p class="text-xs text-secondary mb-2">Postres</p>
        <p class="text-sm text-on-surface-variant mb-4">
          Calle La Plata entre Bolivar y Sucre
        </p>
        <p class="text-xs italic opacity-60">Abierto 09:00 - 22:00</p>
      </div>
      <div
        class="bg-surface p-6 rounded-lg animate-on-scroll from-bottom stagger-5"
      >
        <div class="flex justify-between items-start mb-4">
          <h4 class="font-bold">BonBar</h4>
          <span class="text-primary flex"
            ><span
              class="material-symbols-outlined text-xs"
              style="font-variation-settings: 'FILL' 1;">star</span
            ></span
          >
        </div>
        <p class="text-xs text-secondary mb-2">Comida Típica</p>
        <p class="text-sm text-on-surface-variant mb-4">
          Calle Cochabamba entre Velazco Galvarro y 6 de agosto
        </p>
        <p class="text-xs italic opacity-60">Abierto 12:00 - 19:00</p>
      </div>
      <div
        class="bg-surface p-6 rounded-lg animate-on-scroll from-bottom stagger-6"
      >
        <div class="flex justify-between items-start mb-4">
          <h4 class="font-bold">Nayjama</h4>
          <span class="text-primary flex"
            ><span
              class="material-symbols-outlined text-xs"
              style="font-variation-settings: 'FILL' 1;">star</span
            ></span
          >
        </div>
        <p class="text-xs text-secondary mb-2">Comida tradicional</p>
        <p class="text-sm text-on-surface-variant mb-4">
          Calle Pagador esq. Aldana
        </p>
        <p class="text-xs italic opacity-60">Abierto 11:00 - 21:00</p>
      </div>
      <div
        class="bg-surface p-6 rounded-lg animate-on-scroll from-bottom stagger-7"
      >
        <div class="flex justify-between items-start mb-4">
          <h4 class="font-bold">El Puente</h4>
          <span class="text-primary flex"
            ><span
              class="material-symbols-outlined text-xs"
              style="font-variation-settings: 'FILL' 1;">star</span
            ></span
          >
        </div>
        <p class="text-xs text-secondary mb-2">Charquekan Orureño</p>
        <p class="text-sm text-on-surface-variant mb-4">
          Av. Teniente Villa y 6 de octubre
        </p>
        <p class="text-xs italic opacity-60">Abierto 11:00 - 18:00</p>
      </div>
      <div
        class="bg-surface p-6 rounded-lg animate-on-scroll from-bottom stagger-8"
      >
        <div class="flex justify-between items-start mb-4">
          <h4 class="font-bold">Helados de canela</h4>
          <span class="text-primary flex"
            ><span
              class="material-symbols-outlined text-xs"
              style="font-variation-settings: 'FILL' 1;">star</span
            ></span
          >
        </div>
        <p class="text-xs text-secondary mb-2">Postre tradicional</p>
        <p class="text-sm text-on-surface-variant mb-4">
          Mercado Fermín López, Cochabamba entre P. Montes y Washington
        </p>
        <p class="text-xs italic opacity-60">Abierto 11:00 - 17:00</p>
      </div>
    </div>
  </div>
</section>
