---

---

<section
    class="py-24 bg-surface text-on-surface overflow-hidden relative"
    id="noche-delegaciones"
>
    <div
        class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none"
    >
        <div class="absolute inset-0 hex-pattern"></div>
    </div>

    <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="animate-on-scroll slide-in-left">
                <div
                    class="inline-block px-4 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-widest mb-6"
                >
                    Tradición y Folklore
                </div>
                <h2
                    class="font-headline text-4xl md:text-5xl text-primary mb-6 leading-tight"
                >
                    Noche de Delegaciones: <br />
                    <span class="text-on-surface">Danza y Fraternidad</span>
                </h2>
                <p class="text-lg text-secondary mb-8 leading-relaxed">
                    ¡Celebremos juntos nuestra riqueza cultural! Invitamos a
                    todas las delegaciones a ser parte de esta noche mágica,
                    presentando una danza típica de su región. Un espacio para
                    compartir, disfrutar y fortalecer los lazos de amistad
                    leonística a través del folklore.
                </p>

                <div class="space-y-4 mb-10">
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-5 h-5 text-primary"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-on-surface">
                                Fecha y Hora
                            </h4>
                            <p class="text-sm text-secondary">
                                viernes, 1 de mayo. 20:00 hrs.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-5 h-5 text-primary"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                ></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-on-surface">Lugar</h4>
                            <p class="text-sm text-secondary">
                                Club Oruro - 6 de octubre esq. Adolfo Mier
                            </p>
                        </div>
                    </div>
                </div>

                <a
                    href="https://docs.google.com/forms/d/e/1FAIpQLSd4N5f_5JNAimUYIbjUKKqdzkyxp_loGWafoAfwEhzFcWotVg/viewform?usp=publish-editor"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-3 bg-primary text-on-primary px-8 py-4 rounded-full font-bold text-lg shadow-xl hover:bg-tertiary transition-all active:scale-95 group"
                >
                    <span>Registrar Danza</span>
                    <svg
                        class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
            </div>

            <div class="relative animate-on-scroll slide-in-right">
                <div
                    class="absolute -inset-4 bg-primary/20 rounded-3xl blur-2xl opacity-50"
                >
                </div>
                <div
                    class="relative rounded-2xl overflow-hidden shadow-2xl border border-white/10"
                >
                    <img
                        src="/images/noche_delegaciones_bg.png"
                        alt="Noche de Delegaciones"
                        class="w-full h-auto object-cover aspect-[4/5] lg:aspect-square"
                    />
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-bottom p-8"
                    >
                        <p class="text-white text-sm italic font-light mt-auto">
                            "La danza es el lenguaje oculto del alma"
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .hex-pattern {
        background-image: url("data:image/svg+xml,%3Csvg width='24' height='42' viewBox='0 0 24 42' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%2364c4ed' fill-opacity='0.2'%3E%3Cpath d='M12 3L2 9v12l10 6 10-6V9l-10-6zm0 2l8 4.8v9.6L12 24.2l-8-4.8V9.8L12 5zm-1 25.4l-8-4.8V16l8 4.8v9.6zm2 0l8-4.8V16l-8 4.8v9.6zm-1 7.2l-8-4.8v-9.6l8 4.8v9.6zm2 0l8-4.8v-9.6l-8 4.8v9.6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
</style>
